            <?php
            // Fetch products from products table
            $query = "SELECT * FROM products ORDER BY product_name";
            $result = mysqli_query($conn, $query);
            
            if(mysqli_num_rows($result) > 0) {
                while($row = mysqli_fetch_assoc($result)) {
                    // Get stock quantity for this product
                    $stock_query = "SELECT quantity FROM stock WHERE product_id = " . $row['product_id'];
                    $stock_result = mysqli_query($conn, $stock_query);
                    $stock_data = mysqli_fetch_assoc($stock_result);
                    $stock_quantity = $stock_data ? $stock_data['quantity'] : 0;
                    
                    echo '<div class="product-card">';
                    echo '<h3 class="product-name">' . htmlspecialchars($row['product_name']) . '</h3>';
                    echo '<p class="product-price">₹' . htmlspecialchars($row['price']) . '</p>';
                    
                    // Show stock based on actual quantity
                    if($stock_quantity > 0) {
                        echo '<p class="product-stock"><span class="check-icon">✓</span> Stock: ' . $stock_quantity . ' available</p>';
                    } else {
                        echo '<p class="product-stock" style="color: #dc3545;"><span class="check-icon" style="color: #dc3545;">✗</span> Out of Stock</p>';
                    }
                    
                    echo '<form method="post" style="margin: 0;">';
                    echo '<input type="hidden" name="product_id" value="' . htmlspecialchars($row['product_id']) . '">';
                    echo '<input type="hidden" name="add_to_cart" value="1">';
                    
                    // Disable button if out of stock
                    if($stock_quantity > 0) {
                        echo '<button type="submit" class="buy-btn">Buy Now</button>';
                    } else {
                        echo '<button type="submit" class="buy-btn" disabled style="background: #6c757d; cursor: not-allowed;">Out of Stock</button>';
                    }
                    
                    echo '</form>';
                    echo '</div>';
                }
            } else {
                echo '<p>No products found.</p>';
            }
            ?>
